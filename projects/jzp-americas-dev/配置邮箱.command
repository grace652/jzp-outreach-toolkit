#!/bin/bash
# 双击这个文件即可配置企业邮箱凭据。
# 密码是隐藏输入（屏幕上不显示），不会进入命令行历史，也不会出现在任何对话里。

cd "$(dirname "$0")" || exit 1

PY="$(command -v python3)"

echo "════════════════════════════════════════════════════════════"
echo "  JIEZOU 企业邮箱 · 凭据配置"
echo "════════════════════════════════════════════════════════════"
echo ""
echo "需要提前准备："
echo "  网页版企业邮箱 → 设置 → 邮箱绑定 → 生成「客户端专用密码」"
echo "  （是专用密码，不是你的登录密码）"
echo ""

"$PY" 邮箱客户端.py setup

echo ""
echo "────────────────────────────────────────────────────────────"
echo "配置结束。可以关闭这个窗口。"
echo "────────────────────────────────────────────────────────────"
read -r -p "按回车键关闭…" _
